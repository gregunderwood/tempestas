{
  "name": "pico",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["type:app", "scope:hardware"],
  "implicitDependencies": ["domain", "hardware"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "uv run ruff check .", "cwd": "apps/pico" }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": { "command": "uv run ruff format .", "cwd": "apps/pico" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "uv run pytest -q", "cwd": "apps/pico" }
    }
  }
}
