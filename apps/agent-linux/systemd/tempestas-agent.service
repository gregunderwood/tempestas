# Install to /etc/systemd/system/; see "Deployment" in docs/Infrastructure/Linux Agent.md.

[Unit]
Description=tempestas node agent
# %% is a literal % - systemd reads a bare % as a specifier and drops the line.
Documentation=https://github.com/gregunderwood/tempestas/blob/main/docs/Infrastructure/Linux%%20Agent.md
After=network-online.target mosquitto.service
Wants=network-online.target

# In [Unit], not [Service]: under [Service] systemd ignores them with "Unknown key".
StartLimitIntervalSec=300
StartLimitBurst=5
# On every failed run, not just the last: it switches back only from an update still on its gate.
OnFailure=tempestas-agent-rollback.service

# No ordering against the I2C bus: udev makes no .device unit for it, so the agent fails fast instead.

[Service]
Type=notify
NotifyAccess=main
User=gunderwood
Group=gunderwood
SupplementaryGroups=i2c gpio

# Through `current`, so an update or a hand deploy changes the code by switching one link.
WorkingDirectory=/home/gunderwood/tempestas/agent-linux/current
# The venv interpreter by absolute path: systemd cannot see `uv run` or nvm.
ExecStart=/home/gunderwood/tempestas/agent-linux/venv/bin/python -m tempestas_agent \
    --config /home/gunderwood/tempestas/etc/agent.toml
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/gunderwood/tempestas/agent-linux/current/src
Environment=TEMPESTAS_AGENT_HOME=/home/gunderwood/tempestas/agent-linux
# Required, not `-`: a node with no credential should fail here, not be refused by the broker forever.
EnvironmentFile=/etc/tempestas/agent.env

RuntimeDirectory=tempestas
RuntimeDirectoryMode=0755

# A hung main loop fails the run, so OnFailure rolls a hung update back; 6x its longest pass.
WatchdogSec=60

# Never Restart=always; RestartSec is how long a killed agent leaves its pads unsupervised.
Restart=on-failure
RestartSec=5
# The agent exits 75 once an update is installed, to be started again on the new release.
RestartForceExitStatus=75
# Else that exit counts as a failure, and OnFailure rolls the update back before it ever starts.
SuccessExitStatus=75

OOMScoreAdjust=-900
MemoryMin=64M

StandardOutput=journal
StandardError=journal

PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/gunderwood/tempestas
# No PrivateDevices=yes: it would hide /dev/i2c-1 and /dev/gpiochip0 from the agent.
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
