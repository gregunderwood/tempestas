# Install to /etc/systemd/system/; see "Deployment" in docs/Infrastructure/Linux Agent.md.

[Unit]
Description=tempestas node agent
# %% is a literal % - systemd reads a bare % as a specifier and drops the line.
Documentation=https://github.com/gregunderwood/tempestas/blob/main/docs/Infrastructure/Linux%%20Agent.md
After=network-online.target mosquitto.service
Wants=network-online.target

# In [Unit], not [Service]: under [Service] systemd ignores them with "Unknown key".
StartLimitIntervalSec=300
StartLimitBurst=5

# No ordering against the I2C bus: udev makes no .device unit for it, so the agent fails fast instead.

[Service]
Type=notify
NotifyAccess=main
User=gunderwood
Group=gunderwood
SupplementaryGroups=i2c gpio

WorkingDirectory=/home/gunderwood/tempestas/apps/agent-linux
# The venv interpreter by absolute path: systemd cannot see `uv run` or nvm.
ExecStart=/home/gunderwood/tempestas/apps/agent-linux/.venv/bin/tempestas-agent \
    --config /home/gunderwood/tempestas/etc/agent.toml
Environment=PYTHONUNBUFFERED=1
# Required, not `-`: a node with no credential should fail here, not be refused by the broker forever.
EnvironmentFile=/etc/tempestas/agent.env

RuntimeDirectory=tempestas
RuntimeDirectoryMode=0755

# Never Restart=always; RestartSec is how long a killed agent leaves its pads unsupervised.
Restart=on-failure
RestartSec=5

OOMScoreAdjust=-900
MemoryMin=64M

StandardOutput=journal
StandardError=journal

PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/gunderwood/tempestas
# No PrivateDevices=yes: it would hide /dev/i2c-1 and /dev/gpiochip0 from the agent.
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
