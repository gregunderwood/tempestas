# Temporary: remove with tools/stage-b-soak.py once the Stage B comparison has been read.

[Unit]
Description=tempestas Stage B soak logger (temporary)
After=tempestas-agent.service mosquitto.service
Wants=tempestas-agent.service

[Service]
Type=simple
User=gunderwood
Group=gunderwood
# The read-only observer identity; `-` so a box without the secret still boots.
EnvironmentFile=-/etc/tempestas/soak.env
ExecStart=/home/gunderwood/tempestas/apps/agent-linux/.venv/bin/python \
    /home/gunderwood/tempestas/tools/stage-b-soak.py \
    --out /home/gunderwood/tempestas/soak/stage-b-soak.csv
Restart=on-failure
RestartSec=10
# Well below the agent: if memory gets tight, lose the soak, not the sensor.
OOMScoreAdjust=200
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
