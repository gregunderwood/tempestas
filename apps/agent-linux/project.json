{
  "name": "agent-linux",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["type:app", "scope:agent"],
  "implicitDependencies": ["domain"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "uv run ruff check .", "cwd": "apps/agent-linux" }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": { "command": "uv run ruff format .", "cwd": "apps/agent-linux" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "uv run pytest -q", "cwd": "apps/agent-linux" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "uv run tempestas-agent --simulated", "cwd": "apps/agent-linux" }
    }
  }
}
