# Copy to apps/server/.env for local development.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=tempestas
DATABASE_PASSWORD=tempestas
DATABASE_NAME=tempestas

NODE_ENV=development
PORT=7000

# Explicit IANA zone. NEVER read the host locale - reading the host's *current*
# UTC offset is the DST bug being fixed from the Python system.
TEMPESTAS_TZ=America/Vancouver

# fake | mqtt  - `fake` lets everything up to Phase 7 run with no hardware.
#
# Switching this to `mqtt` makes this process the CONTROLLER of a real node: it
# starts heartbeating, nodes bind to it, and its commands drive relays. Only one
# controller may hold the heartbeat at a time, so starting the Mac's server must
# stop the Pi's. See docs/Safety.md.
HARDWARE_DRIVER=fake

# The broker refuses anonymous clients and scopes every credential to its own
# topics, because an MQTT write here goes straight to a GPIO pin and a propane
# burner. `tempestas-server` is the only identity allowed to publish a command;
# its password lives in .env, never in this file and never in the repo.
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=tempestas-server
MQTT_PASSWORD=

RETENTION_DAYS=90
