# Copy to apps/server/.env for local development.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=tempestas
DATABASE_PASSWORD=tempestas
DATABASE_NAME=tempestas

NODE_ENV=development
PORT=7000

# Explicit IANA zone. NEVER read the host locale - reading the host's *current*
# UTC offset is the DST bug being fixed from the Python system.
TEMPESTAS_TZ=America/Vancouver

# fake | mqtt  - `fake` lets everything up to Phase 7 run with no hardware.
HARDWARE_DRIVER=fake
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=api
MQTT_PASSWORD=

RETENTION_DAYS=90
