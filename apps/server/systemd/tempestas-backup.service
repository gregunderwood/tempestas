# Root-owned script under /usr/local/lib: one in the deploy user's home would let that user edit what postgres runs.

[Unit]
Description=tempestas database backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStartPre=+/usr/bin/install -d -o postgres -g postgres -m 0700 /var/backups/tempestas
ExecStart=/usr/local/lib/tempestas/backup-database.sh
StandardOutput=journal
StandardError=journal
