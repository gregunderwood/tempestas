# Install to /etc/systemd/system/tempestas-migrate@.service
#
#   sudo systemctl start tempestas-migrate@show.service            # read this first
#   sudo systemctl start tempestas-migrate@run.service             # backs up first
#   sudo systemctl start tempestas-migrate@revert-applied.service  # backs up, then undoes what that release's run applied
#   journalctl -u tempestas-migrate@run.service -n 50
#
# A unit rather than a shell command so it reuses the SAME environment file the
# server does. That file is 0600 root because it holds the database and broker
# passwords; systemd reads it as root before dropping privileges, which a
# hand-typed command cannot do without putting a password in the shell history
# or in `ps`.
#
# It runs the release `migrator` points at, which tools/deploy.sh sets to the new release before
# switching to it, so a release migrates and reverts with the code that knows its migrations.
# `show` exits 3 when anything is pending, and 4 when a pending migration cannot be reverted.

[Unit]
Description=tempestas migrations (%i)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=gunderwood
Group=gunderwood
WorkingDirectory=/home/gunderwood/tempestas
EnvironmentFile=/etc/tempestas/server.env
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/node /home/gunderwood/tempestas/migrator/server/main.js migrate:%i
StandardOutput=journal
StandardError=journal
